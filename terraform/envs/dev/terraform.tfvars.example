############################################
# terraform.tfvars.example
# 이 파일을 terraform.tfvars로 복사 후
# 반드시 값을 수정하세요
############################################

########################
# 필수 입력 값
########################

# AWS Region (반드시 입력)
region = "ap-northeast-2"

# 프로젝트 식별자 (리소스 이름에 사용됨)
project = "music-project"
env     = "dev"

########################
# VPC 설정 (필수)
########################

vpc_cidr = "10.1.0.0/16"

# Public Subnets (예: a, c)
public_azs = [
  "ap-northeast-2a",
  "ap-northeast-2c"
]

public_subnets = [
  "10.1.1.0/24",
  "10.1.2.0/24"
]

# Private Subnets (예: b, d)
private_azs = [
  "ap-northeast-2b",
  "ap-northeast-2d"
]

private_subnets = [
  "10.1.11.0/24",
  "10.1.12.0/24"
]

########################
# 공통 태그 (선택)
########################
tags = {
  Owner = "team03"
}
